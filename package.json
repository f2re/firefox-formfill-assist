{
  "name": "firefox-formfill-assist",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Capture-bound Firefox form filling: screenshot, compact AI prompt, strict response validation, preview and no auto-submit.",
  "scripts": {
    "build:bundle": "node scripts/build.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build": "npm run build:bundle && npm run verify:dist",
    "package": "node scripts/package.mjs",
    "verify:version": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run verify:version && npm run typecheck && npm run test",
    "lint:extension": "web-ext lint --source-dir dist",
    "dev": "node scripts/build.mjs --watch"
  },
  "dependencies": {
    "preact": "^10.27.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "web-ext": "^8.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
